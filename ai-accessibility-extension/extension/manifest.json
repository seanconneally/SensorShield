{
  "manifest_version": 3,
  "name": "AI Accessibility & Visual Sensory Helper",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Visual Sensory Shield"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "sensory-shield.js",
        "content.js"
      ],
      "css": [
        "styles.css",
        "sensory-shield.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
